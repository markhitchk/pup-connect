{
  "name": "pup-connect",
  "version": "0.3.0-hive-beta.1",
  "private": true,
  "scripts": {
    "android": "react-native run-android",
    "start": "react-native start",
    "typecheck": "tsc --noEmit && tsc -p server/tsconfig.json",
    "test": "npm run test:hive && npm run test:server && jest --runInBand",
    "test:server": "node --import tsx --test server/test/*.test.ts",
    "server": "node --import tsx server/src/index.ts",
    "android:beta": "cd android && ./gradlew assembleBeta",
    "android:debug": "cd android && ./gradlew assembleDebug",
    "hive:prepare": "node hive/prepare.cjs",
    "test:hive": "node --test hive/test/*.test.cjs",
    "postinstall": "npm run hive:prepare"
  },
  "dependencies": {
    "@react-native-community/netinfo": "12.0.1",
    "b4a": "1.9.0",
    "bare-stow-host": "0.2.0",
    "bare-stow-runtime": "0.1.2",
    "buffer": "6.0.3",
    "hypercore-crypto": "3.7.0",
    "hyperswarm": "4.17.2",
    "react": "19.3.0",
    "react-native": "0.88.1",
    "react-native-bare-kit": "0.17.1",
    "react-native-qrcode-svg": "6.3.54",
    "react-native-safe-area-context": "5.11.1",
    "react-native-svg": "15.16.1",
    "react-native-url-polyfill": "4.0.0",
    "react-native-webrtc": "155.0.1",
    "ws": "8.23.0",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@babel/core": "^7.25.2",
    "@babel/plugin-transform-export-namespace-from": "7.29.7",
    "@babel/preset-env": "^7.25.3",
    "@babel/runtime": "^7.25.0",
    "@react-native-community/cli": "20.2.0",
    "@react-native-community/cli-platform-android": "20.2.0",
    "@react-native-community/cli-platform-ios": "20.2.0",
    "@react-native/babel-preset": "0.88.1",
    "@react-native/eslint-config": "0.88.1",
    "@react-native/jest-preset": "0.88.1",
    "@react-native/metro-config": "0.88.1",
    "@react-native/typescript-config": "0.88.1",
    "@roamhq/wrtc": "0.10.0",
    "@testing-library/react-native": "14.1.0",
    "@types/jest": "^29.5.13",
    "@types/react": "^19.2.0",
    "@types/react-test-renderer": "^19.1.0",
    "@types/ws": "8.18.2",
    "bare-stow": "0.3.9",
    "bare-stow-target-react-native": "0.3.0",
    "eslint": "^8.19.0",
    "jest": "^29.6.3",
    "prettier": "2.8.8",
    "react-test-renderer": "19.3.0",
    "tsx": "4.23.15",
    "typescript": "^6.0.3"
  },
  "engines": {
    "node": ">= 22.11.0"
  }
}
