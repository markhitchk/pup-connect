<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/rootFrame"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/pc_bg">

    <LinearLayout
        android:id="@+id/mainShell"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical">

        <LinearLayout
            android:id="@+id/topAppBar"
            android:layout_width="match_parent"
            android:layout_height="@dimen/app_header_height"
            android:background="@drawable/top_bar_background"
            android:gravity="center_vertical"
            android:paddingStart="8dp"
            android:paddingEnd="8dp">

            <ImageButton
                android:id="@+id/drawerButton"
                android:layout_width="@dimen/app_header_button"
                android:layout_height="@dimen/app_header_button"
                android:background="@drawable/nav_button_background"
                android:contentDescription="Open menu"
                android:padding="10dp"
                android:src="@drawable/ic_menu" />

            <FrameLayout
                android:layout_width="@dimen/app_header_logo"
                android:layout_height="@dimen/app_header_logo"
                android:layout_marginStart="7dp"
                android:background="@drawable/identity_avatar_background">
                <ImageView
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:contentDescription="Pup Connect"
                    android:padding="8dp"
                    android:src="@drawable/ic_paw" />
            </FrameLayout>

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:layout_marginStart="10dp"
                android:orientation="vertical">
                <TextView
                    android:id="@+id/appHeaderTitle"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:maxLines="1"
                    android:text="Pup Connect"
                    android:textColor="@color/pc_text"
                    android:textSize="@dimen/app_header_title_text"
                    android:textStyle="bold" />
                <TextView
                    android:id="@+id/appHeaderSubtitle"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:ellipsize="end"
                    android:maxLines="1"
                    android:text="Harley’s Clan Communication Network"
                    android:textColor="@color/pc_meta"
                    android:textSize="10sp"
                    android:textStyle="bold" />
            </LinearLayout>

            <TextView
                android:id="@+id/liveStatusBadge"
                android:layout_width="wrap_content"
                android:layout_height="28dp"
                android:layout_marginEnd="6dp"
                android:background="@drawable/live_badge_background"
                android:gravity="center"
                android:minWidth="48dp"
                android:paddingStart="8dp"
                android:paddingEnd="8dp"
                android:text="Ready"
                android:textColor="@color/pc_cyan_bright"
                android:textSize="10sp"
                android:textStyle="bold" />

            <FrameLayout
                android:layout_width="@dimen/app_header_button"
                android:layout_height="@dimen/app_header_button">
                <ImageButton
                    android:id="@+id/headerNotificationsButton"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:background="@drawable/nav_button_background"
                    android:contentDescription="Activity"
                    android:padding="10dp"
                    android:src="@drawable/ic_bell" />
                <TextView
                    android:id="@+id/headerNotificationCountBadge"
                    android:layout_width="18dp"
                    android:layout_height="18dp"
                    android:layout_gravity="end|top"
                    android:background="@drawable/notification_count_badge"
                    android:gravity="center"
                    android:text="1"
                    android:textColor="@color/pc_on_accent"
                    android:textSize="9sp"
                    android:textStyle="bold" />
            </FrameLayout>
        </LinearLayout>

        <LinearLayout
            android:id="@+id/connectionBar"
            android:layout_width="match_parent"
            android:layout_height="@dimen/connection_bar_height"
            android:background="@color/pc_connection_bar"
            android:gravity="center_vertical"
            android:padding="5dp">
            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="@dimen/connection_bar_inner_height"
                android:layout_weight="1"
                android:background="@drawable/connection_bar_background"
                android:gravity="center_vertical"
                android:orientation="horizontal">
                <ImageView
                    android:layout_width="24dp"
                    android:layout_height="24dp"
                    android:contentDescription="Secure"
                    android:src="@drawable/ic_lock" />
                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:layout_marginStart="8dp"
                    android:orientation="vertical">
                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="Secure P2P"
                        android:textColor="@color/pc_muted"
                        android:textSize="8sp"
                        android:textStyle="bold" />
                    <TextView
                        android:id="@+id/connectionDetail"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:ellipsize="end"
                        android:maxLines="1"
                        android:text="Ready • WebRTC room service"
                        android:textColor="@color/pc_text"
                        android:textSize="11sp" />
                </LinearLayout>
                <TextView
                    android:id="@+id/relayBadge"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:background="@drawable/live_badge_background"
                    android:paddingStart="8dp"
                    android:paddingTop="4dp"
                    android:paddingEnd="8dp"
                    android:paddingBottom="4dp"
                    android:text="AUTO"
                    android:textColor="@color/pc_cyan"
                    android:textSize="8sp"
                    android:textStyle="bold" />
            </LinearLayout>
            <ImageButton
                android:id="@+id/reconnectButton"
                android:layout_width="@dimen/connection_action_button"
                android:layout_height="@dimen/connection_action_button"
                android:layout_marginStart="6dp"
                android:background="@drawable/nav_button_background"
                android:contentDescription="Reconnect"
                android:padding="9dp"
                android:src="@drawable/ic_refresh" />
        </LinearLayout>

        <TextView
            android:id="@+id/welcomeBanner"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@color/pc_welcome_bg"
            android:paddingStart="14dp"
            android:paddingTop="@dimen/welcome_vertical_padding"
            android:paddingEnd="14dp"
            android:paddingBottom="@dimen/welcome_vertical_padding"
            android:text="Pup Connect • Local identity active • Private by default"
            android:textColor="@color/pc_cyan_bright"
            android:textSize="11sp"
            android:textStyle="bold" />

        <FrameLayout
            android:id="@+id/contentFrame"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1">

            <ScrollView
                android:id="@+id/pageChats"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:fillViewport="true">
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="14dp">
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:background="@drawable/settings_hero_background"
                        android:orientation="vertical">
                        <TextView
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:text="PUP CONNECT NETWORK"
                            android:textColor="@color/pc_cyan"
                            android:textSize="10sp"
                            android:textStyle="bold" />
                        <TextView
                            android:id="@+id/screenTitle"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="9dp"
                            android:text="Connect with your pack"
                            android:textColor="@color/pc_text"
                            android:textSize="25sp"
                            android:textStyle="bold" />
                        <TextView
                            android:id="@+id/screenSubtitle"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="5dp"
                            android:text="Private WebRTC rooms for messages, voice and video."
                            android:textColor="@color/pc_muted"
                            android:textSize="14sp" />
                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="18dp"
                            android:orientation="horizontal">
                            <Button
                                android:id="@+id/createRoomButton"
                                android:layout_width="0dp"
                                android:layout_height="50dp"
                                android:layout_weight="1"
                                android:background="@drawable/accent_button_background"
                                android:text="Create room"
                                android:textAllCaps="false"
                                android:textColor="@color/pc_on_accent"
                                android:textStyle="bold" />
                            <Button
                                android:id="@+id/joinRoomButton"
                                android:layout_width="0dp"
                                android:layout_height="50dp"
                                android:layout_weight="1"
                                android:layout_marginStart="10dp"
                                android:background="@drawable/secondary_button_background"
                                android:text="Join room"
                                android:textAllCaps="false"
                                android:textColor="@color/pc_cyan"
                                android:textStyle="bold" />
                        </LinearLayout>
                    </LinearLayout>

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="20dp"
                        android:layout_marginBottom="8dp"
                        android:text="Quick status"
                        android:textColor="@color/pc_text"
                        android:textSize="16sp"
                        android:textStyle="bold" />
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal">
                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:background="@drawable/card_background"
                            android:orientation="vertical">
                            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Transport" android:textColor="@color/pc_muted" android:textSize="10sp" />
                            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="4dp" android:text="WebRTC" android:textColor="@color/pc_cyan" android:textSize="15sp" android:textStyle="bold" />
                        </LinearLayout>
                        <Space android:layout_width="8dp" android:layout_height="1dp" />
                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:background="@drawable/card_background"
                            android:orientation="vertical">
                            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Identity" android:textColor="@color/pc_muted" android:textSize="10sp" />
                            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="4dp" android:text="Local" android:textColor="@color/pc_cyan" android:textSize="15sp" android:textStyle="bold" />
                        </LinearLayout>
                    </LinearLayout>

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="22dp"
                        android:layout_marginBottom="8dp"
                        android:text="Recent rooms"
                        android:textColor="@color/pc_text"
                        android:textSize="17sp"
                        android:textStyle="bold" />
                    <LinearLayout
                        android:id="@+id/recentSection"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:background="@drawable/card_background"
                        android:gravity="center_vertical"
                        android:orientation="horizontal">
                        <FrameLayout
                            android:layout_width="48dp"
                            android:layout_height="48dp"
                            android:background="@drawable/identity_avatar_background">
                            <ImageView android:layout_width="match_parent" android:layout_height="match_parent" android:padding="9dp" android:src="@drawable/ic_paw" />
                        </FrameLayout>
                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:layout_marginStart="12dp"
                            android:orientation="vertical">
                            <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="Welcome Pack" android:textColor="@color/pc_text" android:textSize="15sp" android:textStyle="bold" />
                            <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="3dp" android:text="Your first Pup Connect room will appear here." android:textColor="@color/pc_muted" android:textSize="11sp" />
                        </LinearLayout>
                    </LinearLayout>
                </LinearLayout>
            </ScrollView>

            <ScrollView
                android:id="@+id/pageCalls"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:fillViewport="true"
                android:visibility="gone">
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="14dp">
                    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:background="@drawable/settings_hero_background" android:orientation="vertical">
                        <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="CALLS" android:textColor="@color/pc_cyan" android:textSize="10sp" android:textStyle="bold" />
                        <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="8dp" android:text="Voice &amp; video" android:textColor="@color/pc_text" android:textSize="25sp" android:textStyle="bold" />
                        <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="5dp" android:text="Private room calls with microphone, camera and push-to-talk controls." android:textColor="@color/pc_muted" android:textSize="14sp" />
                    </LinearLayout>
                    <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="20dp" android:layout_marginBottom="8dp" android:text="Call controls" android:textColor="@color/pc_text" android:textSize="16sp" android:textStyle="bold" />
                    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:background="@drawable/settings_section_body" android:orientation="vertical">
                        <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="Microphone permissions" android:textColor="@color/pc_text" android:textSize="14sp" android:textStyle="bold" />
                        <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="4dp" android:text="Requested only when a call starts." android:textColor="@color/pc_muted" android:textSize="11sp" />
                        <View android:layout_width="match_parent" android:layout_height="1dp" android:layout_marginTop="12dp" android:layout_marginBottom="12dp" android:background="@color/pc_divider" />
                        <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="Camera permissions" android:textColor="@color/pc_text" android:textSize="14sp" android:textStyle="bold" />
                        <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="4dp" android:text="Video stays off until you enable it." android:textColor="@color/pc_muted" android:textSize="11sp" />
                    </LinearLayout>
                </LinearLayout>
            </ScrollView>

            <ScrollView
                android:id="@+id/pagePack"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:fillViewport="true"
                android:visibility="gone">
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="14dp">
                    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:background="@drawable/settings_hero_background" android:orientation="vertical">
                        <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="PACK" android:textColor="@color/pc_cyan" android:textSize="10sp" android:textStyle="bold" />
                        <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="8dp" android:text="Your people" android:textColor="@color/pc_text" android:textSize="25sp" android:textStyle="bold" />
                        <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="5dp" android:text="Local profile, trusted contacts and room members." android:textColor="@color/pc_muted" android:textSize="14sp" />
                    </LinearLayout>
                    <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="20dp" android:layout_marginBottom="8dp" android:text="Your identity" android:textColor="@color/pc_text" android:textSize="16sp" android:textStyle="bold" />
                    <LinearLayout
                        android:id="@+id/packIdentityCard"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:background="@drawable/identity_card_background"
                        android:gravity="center_vertical"
                        android:orientation="horizontal">
                        <FrameLayout android:layout_width="58dp" android:layout_height="58dp" android:background="@drawable/identity_avatar_background">
                            <ImageView android:layout_width="match_parent" android:layout_height="match_parent" android:padding="11dp" android:src="@drawable/ic_paw" />
                        </FrameLayout>
                        <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:layout_marginStart="12dp" android:orientation="vertical">
                            <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="Local Pup" android:textColor="@color/pc_text" android:textSize="16sp" android:textStyle="bold" />
                            <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="2dp" android:text="Device-only identity" android:textColor="@color/pc_cyan" android:textSize="11sp" />
                            <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="3dp" android:text="Private until you choose otherwise." android:textColor="@color/pc_muted" android:textSize="9sp" />
                        </LinearLayout>
                        <ImageView android:layout_width="34dp" android:layout_height="34dp" android:padding="6dp" android:src="@drawable/ic_shield" />
                    </LinearLayout>
                </LinearLayout>
            </ScrollView>

            <ScrollView
                android:id="@+id/pageSettings"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:fillViewport="true"
                android:visibility="gone">
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="14dp"
                    android:paddingBottom="24dp">
                    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:background="@drawable/settings_hero_background" android:orientation="vertical">
                        <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="PUP CONNECT // SETTINGS" android:textColor="@color/pc_cyan" android:textSize="10sp" android:textStyle="bold" />
                        <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="8dp" android:text="App Settings" android:textColor="@color/pc_text" android:textSize="25sp" android:textStyle="bold" />
                        <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="5dp" android:text="Connection, privacy, calls, appearance and diagnostics." android:textColor="@color/pc_muted" android:textSize="13sp" />
                    </LinearLayout>

                    <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="20dp" android:layout_marginBottom="7dp" android:text="Connection &amp; relay" android:textColor="@color/pc_text" android:textSize="16sp" android:textStyle="bold" />
                    <LinearLayout android:id="@+id/settingsConnection" android:layout_width="match_parent" android:layout_height="wrap_content" android:background="@drawable/settings_section_body" android:clickable="true" android:focusable="true" android:orientation="vertical">
                        <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="WebRTC transport" android:textColor="@color/pc_text" android:textSize="14sp" android:textStyle="bold" />
                        <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="4dp" android:text="Direct peer path with TURN fallback support." android:textColor="@color/pc_muted" android:textSize="11sp" />
                    </LinearLayout>

                    <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="16dp" android:layout_marginBottom="7dp" android:text="Privacy &amp; security" android:textColor="@color/pc_text" android:textSize="16sp" android:textStyle="bold" />
                    <LinearLayout android:id="@+id/settingsPrivacy" android:layout_width="match_parent" android:layout_height="wrap_content" android:background="@drawable/settings_section_body" android:clickable="true" android:focusable="true" android:orientation="vertical">
                        <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="Private by default" android:textColor="@color/pc_text" android:textSize="14sp" android:textStyle="bold" />
                        <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="4dp" android:text="Local identity and history stay on-device." android:textColor="@color/pc_muted" android:textSize="11sp" />
                    </LinearLayout>

                    <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="16dp" android:layout_marginBottom="7dp" android:text="Audio &amp; video" android:textColor="@color/pc_text" android:textSize="16sp" android:textStyle="bold" />
                    <LinearLayout android:id="@+id/settingsMedia" android:layout_width="match_parent" android:layout_height="wrap_content" android:background="@drawable/settings_section_body" android:clickable="true" android:focusable="true" android:orientation="vertical">
                        <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="Call permissions &amp; defaults" android:textColor="@color/pc_text" android:textSize="14sp" android:textStyle="bold" />
                        <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="4dp" android:text="Microphone, camera, speaker route and push-to-talk." android:textColor="@color/pc_muted" android:textSize="11sp" />
                    </LinearLayout>

                    <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="16dp" android:layout_marginBottom="7dp" android:text="Appearance" android:textColor="@color/pc_text" android:textSize="16sp" android:textStyle="bold" />
                    <LinearLayout android:id="@+id/settingsAppearance" android:layout_width="match_parent" android:layout_height="wrap_content" android:background="@drawable/settings_section_body" android:clickable="true" android:focusable="true" android:orientation="vertical">
                        <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="Follow device theme" android:textColor="@color/pc_text" android:textSize="14sp" android:textStyle="bold" />
                        <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="4dp" android:text="HCF-derived light and dark palettes." android:textColor="@color/pc_muted" android:textSize="11sp" />
                    </LinearLayout>

                    <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="16dp" android:layout_marginBottom="7dp" android:text="Diagnostics" android:textColor="@color/pc_text" android:textSize="16sp" android:textStyle="bold" />
                    <LinearLayout android:id="@+id/settingsDiagnostics" android:layout_width="match_parent" android:layout_height="wrap_content" android:background="@drawable/settings_section_body" android:clickable="true" android:focusable="true" android:orientation="vertical">
                        <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="Build &amp; connection information" android:textColor="@color/pc_text" android:textSize="14sp" android:textStyle="bold" />
                        <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="4dp" android:text="Pup Connect 0.1.0-alpha • API 26+ • Native Java/XML" android:textColor="@color/pc_muted" android:textSize="11sp" />
                    </LinearLayout>
                </LinearLayout>
            </ScrollView>

            <FrameLayout
                android:id="@+id/startupOverlay"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:background="@drawable/splash_background"
                android:clickable="true"
                android:elevation="12dp"
                android:focusable="true">
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:gravity="center"
                    android:orientation="vertical"
                    android:padding="24dp">
                    <FrameLayout android:layout_width="@dimen/startup_logo_size" android:layout_height="@dimen/startup_logo_size" android:background="@drawable/identity_avatar_background">
                        <ImageView android:layout_width="match_parent" android:layout_height="match_parent" android:padding="24dp" android:src="@drawable/ic_paw" />
                    </FrameLayout>
                    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="18dp" android:text="Starting Pup Connect…" android:textColor="@color/pc_text" android:textSize="17sp" android:textStyle="bold" />
                    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="6dp" android:text="Preparing your private communication space" android:textColor="@color/pc_muted" android:textSize="11sp" />
                    <ProgressBar android:layout_width="48dp" android:layout_height="48dp" android:layout_marginTop="18dp" android:indeterminateTint="@color/pc_cyan" style="?android:attr/progressBarStyleLarge" />
                </LinearLayout>
            </FrameLayout>
        </FrameLayout>

        <LinearLayout
            android:id="@+id/bottomNav"
            android:layout_width="match_parent"
            android:layout_height="@dimen/bottom_nav_height"
            android:background="@drawable/bottom_bar_background"
            android:elevation="18dp"
            android:gravity="center"
            android:orientation="horizontal"
            android:paddingStart="5dp"
            android:paddingTop="4dp"
            android:paddingEnd="5dp"
            android:paddingBottom="4dp">
            <TextView android:id="@+id/navChats" style="@style/PupConnect.BottomNavItem" android:drawableTop="@drawable/ic_chat" android:drawableTint="@color/nav_text_selector" android:drawablePadding="2dp" android:text="Chats" />
            <TextView android:id="@+id/navCalls" style="@style/PupConnect.BottomNavItem" android:drawableTop="@drawable/ic_phone" android:drawableTint="@color/nav_text_selector" android:drawablePadding="2dp" android:text="Calls" />
            <TextView android:id="@+id/navCreate" style="@style/PupConnect.BottomNavItem" android:layout_marginStart="4dp" android:layout_marginEnd="4dp" android:background="@drawable/bottom_nav_action_background" android:drawableTop="@drawable/ic_plus" android:drawablePadding="2dp" android:text="Room" android:textColor="@color/pc_on_accent" android:textStyle="bold" />
            <TextView android:id="@+id/navPack" style="@style/PupConnect.BottomNavItem" android:drawableTop="@drawable/ic_group" android:drawableTint="@color/nav_text_selector" android:drawablePadding="2dp" android:text="Pack" />
            <TextView android:id="@+id/navSettings" style="@style/PupConnect.BottomNavItem" android:drawableTop="@drawable/ic_settings" android:drawableTint="@color/nav_text_selector" android:drawablePadding="2dp" android:text="Settings" />
        </LinearLayout>
    </LinearLayout>

    <View
        android:id="@+id/drawerScrim"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@color/pc_scrim"
        android:clickable="true"
        android:focusable="true"
        android:visibility="gone" />

    <LinearLayout
        android:id="@+id/drawerPanel"
        android:layout_width="@dimen/drawer_width"
        android:layout_height="match_parent"
        android:layout_gravity="start"
        android:background="@drawable/drawer_background"
        android:elevation="30dp"
        android:orientation="vertical"
        android:padding="@dimen/drawer_padding"
        android:visibility="gone">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:padding="6dp">
            <FrameLayout android:layout_width="@dimen/drawer_logo" android:layout_height="@dimen/drawer_logo" android:background="@drawable/identity_avatar_background">
                <ImageView android:layout_width="match_parent" android:layout_height="match_parent" android:padding="9dp" android:src="@drawable/ic_paw" />
            </FrameLayout>
            <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:layout_marginStart="10dp" android:orientation="vertical">
                <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="Pup Connect" android:textColor="@color/pc_text" android:textSize="16sp" android:textStyle="bold" />
                <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="Private WebRTC communication" android:textColor="@color/pc_cyan" android:textSize="10sp" />
            </LinearLayout>
        </LinearLayout>

        <View android:layout_width="match_parent" android:layout_height="1dp" android:layout_marginTop="7dp" android:layout_marginBottom="10dp" android:background="@color/pc_divider" />

        <LinearLayout
            android:id="@+id/drawerIdentityCard"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@drawable/identity_card_background"
            android:clickable="true"
            android:focusable="true"
            android:gravity="center_vertical"
            android:minHeight="@dimen/identity_card_min_height"
            android:orientation="horizontal">
            <FrameLayout android:layout_width="@dimen/identity_avatar_size" android:layout_height="@dimen/identity_avatar_size" android:background="@drawable/identity_avatar_background">
                <ImageView android:layout_width="match_parent" android:layout_height="match_parent" android:padding="12dp" android:src="@drawable/ic_paw" />
            </FrameLayout>
            <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:layout_marginStart="11dp" android:orientation="vertical">
                <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="Pup Identity" android:textColor="@color/pc_meta" android:textSize="9sp" android:textStyle="bold" />
                <TextView android:id="@+id/drawerIdentityText" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="Local Pup" android:textColor="@color/pc_text" android:textSize="15sp" android:textStyle="bold" />
                <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="Device-only profile" android:textColor="@color/pc_cyan" android:textSize="11sp" />
            </LinearLayout>
            <ImageButton android:id="@+id/drawerSecurity" android:layout_width="36dp" android:layout_height="36dp" android:background="@drawable/nav_button_background" android:contentDescription="Privacy and security" android:padding="7dp" android:src="@drawable/ic_shield" />
        </LinearLayout>

        <View android:layout_width="match_parent" android:layout_height="1dp" android:layout_marginTop="10dp" android:layout_marginBottom="10dp" android:background="@color/pc_divider" />

        <ScrollView
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:fillViewport="true">
            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical">
                <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:paddingStart="6dp" android:paddingBottom="6dp" android:text="Communication" android:textColor="@color/pc_muted" android:textSize="10sp" android:textStyle="bold" />
                <Button android:id="@+id/drawerChats" style="@style/PupConnectDrawerItem" android:text="Chats" />
                <Button android:id="@+id/drawerCalls" style="@style/PupConnectDrawerItem" android:text="Calls" />
                <Button android:id="@+id/drawerPack" style="@style/PupConnectDrawerItem" android:text="Pack" />
                <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="12dp" android:paddingStart="6dp" android:paddingBottom="6dp" android:text="Rooms" android:textColor="@color/pc_muted" android:textSize="10sp" android:textStyle="bold" />
                <Button android:id="@+id/drawerCreateRoom" style="@style/PupConnectDrawerItem" android:text="Create Room" />
                <Button android:id="@+id/drawerJoinRoom" style="@style/PupConnectDrawerItem" android:text="Join Room" />
                <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="12dp" android:paddingStart="6dp" android:paddingBottom="6dp" android:text="App" android:textColor="@color/pc_muted" android:textSize="10sp" android:textStyle="bold" />
                <Button android:id="@+id/drawerSettings" style="@style/PupConnectDrawerItem" android:text="App Settings" />
                <Button android:id="@+id/drawerConnection" style="@style/PupConnectDrawerItem" android:text="Connection Status" />
                <Button android:id="@+id/drawerAbout" style="@style/PupConnectDrawerItem" android:text="About Pup Connect" />
            </LinearLayout>
        </ScrollView>

        <TextView
            android:id="@+id/drawerVersionText"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center"
            android:paddingTop="6dp"
            android:paddingBottom="2dp"
            android:text="Pup Connect v0.1.0-alpha • HCF UI"
            android:textColor="@color/pc_hint"
            android:textSize="9sp" />
    </LinearLayout>
</FrameLayout>
