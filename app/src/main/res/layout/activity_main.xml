<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@color/pc_bg">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="68dp"
        android:gravity="center_vertical"
        android:paddingStart="16dp"
        android:paddingEnd="12dp"
        android:background="@color/pc_app_bar">

        <TextView
            android:layout_width="46dp"
            android:layout_height="46dp"
            android:gravity="center"
            android:text="🐾"
            android:textSize="24sp"
            android:background="@drawable/avatar_background"
            android:contentDescription="Pup Connect" />

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical"
            android:layout_marginStart="11dp">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Pup Connect"
                android:textColor="@color/pc_text"
                android:textStyle="bold"
                android:textSize="18sp" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Harley’s Clan Communication Network"
                android:textColor="@color/pc_cyan"
                android:textStyle="bold"
                android:textSize="10sp"
                android:maxLines="1"
                android:ellipsize="end" />
        </LinearLayout>

        <TextView
            android:id="@+id/headerAddButton"
            android:layout_width="42dp"
            android:layout_height="42dp"
            android:gravity="center"
            android:text="+"
            android:textColor="@color/pc_cyan"
            android:textSize="28sp"
            android:background="@drawable/nav_item_background"
            android:contentDescription="Create room" />
    </LinearLayout>

    <View
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:background="@color/pc_divider" />

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:fillViewport="true">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="18dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="18dp"
                android:background="@drawable/hero_background">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical">

                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="P2P ready"
                        android:textColor="@color/pc_cyan"
                        android:textStyle="bold"
                        android:textSize="12sp" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="28dp"
                        android:gravity="center"
                        android:paddingStart="10dp"
                        android:paddingEnd="10dp"
                        android:text="ALPHA"
                        android:textColor="@color/pc_cyan"
                        android:textStyle="bold"
                        android:textSize="10sp"
                        android:background="@drawable/status_badge_background" />
                </LinearLayout>

                <TextView
                    android:id="@+id/screenTitle"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:text="Connect with your pack"
                    android:textColor="@color/pc_text"
                    android:textStyle="bold"
                    android:textSize="25sp" />

                <TextView
                    android:id="@+id/screenSubtitle"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="5dp"
                    android:text="Private rooms for chat, voice and video"
                    android:textColor="@color/pc_muted"
                    android:textSize="14sp" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:layout_marginTop="18dp">

                    <TextView
                        android:id="@+id/createRoomButton"
                        android:layout_width="0dp"
                        android:layout_height="50dp"
                        android:layout_weight="1"
                        android:gravity="center"
                        android:text="Create room"
                        android:textColor="@color/pc_on_accent"
                        android:textStyle="bold"
                        android:textSize="14sp"
                        android:background="@drawable/accent_button_background" />

                    <Space
                        android:layout_width="10dp"
                        android:layout_height="1dp" />

                    <TextView
                        android:id="@+id/joinRoomButton"
                        android:layout_width="0dp"
                        android:layout_height="50dp"
                        android:layout_weight="1"
                        android:gravity="center"
                        android:text="Join room"
                        android:textColor="@color/pc_cyan"
                        android:textStyle="bold"
                        android:textSize="14sp"
                        android:background="@drawable/secondary_button_background" />
                </LinearLayout>
            </LinearLayout>

            <LinearLayout
                android:id="@+id/recentSection"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical">

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="24dp"
                    android:layout_marginBottom="10dp"
                    android:text="Recent rooms"
                    android:textColor="@color/pc_text"
                    android:textStyle="bold"
                    android:textSize="17sp" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="82dp"
                    android:gravity="center_vertical"
                    android:padding="14dp"
                    android:background="@drawable/card_background">

                    <TextView
                        android:layout_width="46dp"
                        android:layout_height="46dp"
                        android:gravity="center"
                        android:text="🐶"
                        android:textSize="23sp"
                        android:background="@drawable/avatar_background" />

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:layout_marginStart="12dp"
                        android:orientation="vertical">

                        <TextView
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:text="Welcome Pack"
                            android:textColor="@color/pc_text"
                            android:textStyle="bold"
                            android:textSize="15sp" />

                        <TextView
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="4dp"
                            android:text="Pup Connect is ready to start connecting."
                            android:textColor="@color/pc_muted"
                            android:textSize="12sp"
                            android:maxLines="1"
                            android:ellipsize="end" />
                    </LinearLayout>

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="NOW"
                        android:textColor="@color/pc_cyan"
                        android:textStyle="bold"
                        android:textSize="9sp" />
                </LinearLayout>
            </LinearLayout>

            <TextView
                android:id="@+id/emptyState"
                android:layout_width="match_parent"
                android:layout_height="180dp"
                android:gravity="center"
                android:padding="24dp"
                android:textColor="@color/pc_muted"
                android:textSize="14sp"
                android:visibility="gone" />
        </LinearLayout>
    </ScrollView>

    <View
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:background="@color/pc_divider" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="70dp"
        android:orientation="horizontal"
        android:paddingStart="8dp"
        android:paddingEnd="8dp"
        android:paddingTop="6dp"
        android:paddingBottom="8dp"
        android:background="@color/pc_nav_bg">

        <TextView
            android:id="@+id/navChats"
            style="@style/PupConnect.BottomNavItem"
            android:text="●\nChats" />

        <TextView
            android:id="@+id/navCalls"
            style="@style/PupConnect.BottomNavItem"
            android:text="☎\nCalls" />

        <TextView
            android:id="@+id/navPack"
            style="@style/PupConnect.BottomNavItem"
            android:text="♟\nPack" />

        <TextView
            android:id="@+id/navSettings"
            style="@style/PupConnect.BottomNavItem"
            android:text="⚙\nSettings" />
    </LinearLayout>

</LinearLayout>
